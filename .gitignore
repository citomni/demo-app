###> citomni/app-skeleton ###
# Defaults from citomni/app-skeleton. citomni/installer inserts its block below
# this one; package rules there take precedence over these defaults.
# Put application rules at the end of the file; they take precedence over both.
/_*/
/vendor/
/auth.json
/node_modules/
**/_backups/
*.bck

/var/backups/*
!/var/backups/.gitkeep
/var/cache/*
!/var/cache/.gitkeep
/var/flags/*
!/var/flags/.gitkeep
/var/logs/*
!/var/logs/.gitkeep
/var/nonces/*
!/var/nonces/.gitkeep
/var/secrets/*
!/var/secrets/.gitkeep
/var/state/*
!/var/state/.gitkeep
/var/storage/*
!/var/storage/.gitkeep
###< citomni/app-skeleton ###

###> citomni/installer ###
# Generated by citomni/installer from the installed package manifests.
# Rewritten by install, sync and migrate; edits inside this block are lost.
# Application rules belong after the block.

# Package runtime paths
/public/uploads/u/*
/var/backups/*
/var/cache/*
/var/flags/*
/var/logs/*
/var/nonces/*
/var/secrets/*
/var/state/*

# Package runtime files kept in Git
!/public/uploads/u/.gitkeep
!/var/backups/.gitkeep
!/var/cache/.gitkeep
!/var/flags/.gitkeep
!/var/logs/.gitkeep
!/var/nonces/.gitkeep
!/var/secrets/.gitkeep
!/var/secrets/webhooks.secret.php.tpl
!/var/state/.gitkeep

# Package-managed scaffold targets
/.htaccess
/bin/.htaccess
/bin/citomni
/config/.htaccess
/language/.htaccess
/public/.htaccess
/public/index.php
/public/robots.txt
/public/uploads/.htaccess
/src/.htaccess
/templates/.htaccess
/tests/.htaccess
/var/.htaccess
###< citomni/installer ###

# Application rules: everything below takes precedence over both blocks above.

